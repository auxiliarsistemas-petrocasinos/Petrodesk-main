# URL de conexión a la base de datos (Pooler de Supabase - Transaction Mode, puerto 6543)
# Reemplaza [PROJECT_REF], [PASSWORD] y [REGION] con tus datos de Supabase.
# pgbouncer=true es importante para el modo transacción
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL de conexión directa a la base de datos (Direct Connection, puerto 5432 o Session Mode)
# Requerido por Prisma para aplicar cambios en el esquema y ejecutar seeds
DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Credenciales de API de Supabase para almacenamiento (Storage)
# Consíguelas en Project Settings -> API en tu Dashboard de Supabase.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="[SUPABASE_SERVICE_ROLE_KEY_OR_ANON_KEY]"

# Clave secreta para la autenticación JWT en NestJS (Elige una palabra clave segura para tu servidor)
JWT_SECRET=
